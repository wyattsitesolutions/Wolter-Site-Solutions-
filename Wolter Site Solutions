<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:'Montserrat',sans-serif;
    background:#111;
    color:#fff;
}

nav{
    position:fixed;
    width:100%;
    top:0;
    left:0;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:22px 8%;
    background:rgba(20,20,20,.75);
    backdrop-filter:blur(14px);
    z-index:1000;
}

nav h2{
    font-size:28px;
    letter-spacing:2px;
    color:#d6a84f;
}

nav ul{
    display:flex;
    list-style:none;
    gap:35px;
}

nav a{
    color:white;
    text-decoration:none;
    transition:.3s;
}

nav a:hover{
    color:#d6a84f;
}

.hero{
    height:100vh;
    background:
    linear-gradient(rgba(0,0,0,.65),rgba(0,0,0,.65)),
    url("https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1800&q=80");
    background-size:cover;
    background-position:center;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:20px;
}

.hero h1{
    font-size:70px;
    letter-spacing:3px;
    margin-bottom:20px;
}

.hero p{
    font-size:22px;
    color:#ddd;
    margin-bottom:40px;
}

.button{
    display:inline-block;
    background:#d6a84f;
    color:#111;
    padding:18px 42px;
    text-decoration:none;
    border-radius:40px;
    font-weight:700;
    transition:.3s;
}

.button:hover{
    background:white;
}

section{
    padding:90px 8%;
}

.section-title{
    text-align:center;
    font-size:42px;
    margin-bottom:60px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:30px;
}

.card{
    background:#1b1b1b;
    padding:35px;
    border-radius:16px;
    border:1px solid #2f2f2f;
    transition:.3s;
}

.card:hover{
    transform:translateY(-10px);
    border-color:#d6a84f;
}

.card h3{
    color:#d6a84f;
    margin-bottom:15px;
}

.about{
    background:#181818;
    text-align:center;
}

.about p{
    max-width:900px;
    margin:auto;
    color:#ccc;
    line-height:1.8;
}

.contact{
    text-align:center;
}

.contact h3{
    font-size:38px;
    margin-bottom:20px;
}

.phone{
    font-size:34px;
    color:#d6a84f;
    margin:25px 0;
}

footer{
    text-align:center;
    background:#0a0a0a;
    padding:30px;
    color:#888;
}

@media(max-width:800px){

nav{
flex-direction:column;
gap:15px;
}

nav ul{
flex-wrap:wrap;
justify-content:center;
}

.hero h1{
font-size:44px;
}

.hero p{
font-size:18px;
}

}
</style>

